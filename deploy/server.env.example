# Copy to <deploy folder>/.env on the server (read by docker compose for ${...} values).
# Dev lives in /opt/taskflow, staging in /opt/taskflow-staging. The folder name is the compose project name,
# which keeps containers, networks and the database volume of each environment separate.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=dev
# Name Caddy uses to reach this app on the shared "web" network: dev-app, staging-app or prod-app.
PROXY_ALIAS=dev-app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
